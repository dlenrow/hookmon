{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Forensics",
      "url": "/d/hookmon-forensics",
      "tooltip": "Event timelines, counts and breakdowns for investigation",
      "icon": "search",
      "type": "link"
    }
  ],
  "panels": [
    {
      "title": "Fleet Health",
      "description": "Shows ALL SENSORS OPERATIONAL when fleet is healthy, or SENSOR COVERAGE DEGRADED when any host has dead sensors or is unreachable.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "ALL SENSORS OPERATIONAL", "color": "green" } } },
            { "type": "range", "options": { "from": 1, "to": 9999, "result": { "text": "SENSOR COVERAGE DEGRADED", "color": "red" } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "(sum(hookmon_fleet_hosts_degraded) or vector(0)) + (sum(hookmon_fleet_hosts_unreachable) or vector(0))",
          "legendFormat": "affected"
        }
      ]
    },
    {
      "title": "Fleet Status",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "host", "desc": false }]
      },
      "targets": [
        {
          "expr": "hookmon_fleet_host_reachable",
          "legendFormat": "{{host}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "title": "Sensor Health Grid (24h)",
      "description": "Per-host, per-sensor alive/dead status over time.",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DEAD", "color": "red" }, "1": { "text": "ALIVE", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "alignValue": "left",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "hookmon_fleet_sensor_alive",
          "legendFormat": "{{host}} / {{sensor}}"
        }
      ]
    },
    {
      "title": "Active Sensors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "hookmon_sensors_active",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "title": "Sensor Errors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(hookmon_sensor_errors_total)",
          "legendFormat": "errors"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["hookmon", "security", "fleet-health"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "HookMon Fleet Health",
  "uid": "hookmon-fleet-health",
  "version": 1
}
