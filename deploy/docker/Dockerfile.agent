FROM golang:1.24.13-bookworm@sha256:1a6d4452c65dea36aac2e2d606b01b4a029ec90cc1ae53890540ce6173ea77ac AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    clang llvm libbpf-dev bpftool \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
ARG VERSION=dev
RUN make bpf build-dlopen-probe && CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-s -w -X github.com/dlenrow/hookmon/pkg/version.Version=${VERSION}" \
    -o /hookmon-bus ./cmd/hookmon-bus

FROM debian:bookworm-20260918-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /hookmon-bus /usr/bin/hookmon-bus
# dlopen_monitor liveness probe; the bus looks for it next to its own binary.
COPY --from=builder /build/bin/hookmon-dlopen-probe /usr/bin/hookmon-dlopen-probe

RUN mkdir -p /etc/hookmon /var/log/hookmon

# Sensor bus needs elevated privileges for eBPF
# Run with: --privileged or --cap-add=SYS_ADMIN --cap-add=BPF
ENTRYPOINT ["/usr/bin/hookmon-bus"]
CMD ["--config", "/etc/hookmon/bus.yaml"]
