FROM golang:1.24-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    clang llvm libbpf-dev bpftool \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN make bpf build-dlopen-probe && CGO_ENABLED=0 GOOS=linux go build -ldflags "-s -w" -o /hookmon-bus ./cmd/hookmon-bus

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /hookmon-bus /usr/bin/hookmon-bus
# dlopen_monitor liveness probe; the bus looks for it next to its own binary.
COPY --from=builder /build/bin/hookmon-dlopen-probe /usr/bin/hookmon-dlopen-probe

RUN mkdir -p /etc/hookmon /var/log/hookmon

# Sensor bus needs elevated privileges for eBPF
# Run with: --privileged or --cap-add=SYS_ADMIN --cap-add=BPF
ENTRYPOINT ["/usr/bin/hookmon-bus"]
CMD ["--config", "/etc/hookmon/bus.yaml"]
